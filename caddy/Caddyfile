{$DOMAIN:localhost} {
    encode gzip zstd

    # Header bảo mật toàn diện & HSTS tự động
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        -Server
    }

    # Phục vụ thư mục uploads ảnh trực tiếp với cache dài hạn
    handle_path /uploads/* {
        root * /srv/uploads
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Reverse proxy toàn bộ ứng dụng Next.js (hỗ trợ SSE keep-alive và real IP)
    handle {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }
}
