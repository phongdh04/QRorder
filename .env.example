# Database connection (PostgreSQL 16)
DATABASE_URL="postgresql://qrorder:qrorder_secret@db:5432/qrorder_db?schema=public"

# Session & JWT secret (generate a secure random 32+ char string in production)
SESSION_SECRET="super-secret-jwt-key-qrorder-bar-32chars-minimum-key"

# Domain for Production Caddy Reverse Proxy & HTTPS
DOMAIN="localhost"

# File Upload Directory
UPLOAD_DIR="/app/public/uploads"

# Application Port
PORT=3000

# Node Environment
NODE_ENV="development"
