# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG QR ORDER (MẪU .env)
# Sao chép file này thành .env trên server và thay đổi các giá trị bí mật
# ==============================================================================

# 1. Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_USER="qrorder"
POSTGRES_PASSWORD="CHANGE_THIS_STRONG_PASSWORD_123"
POSTGRES_DB="qrorder_db"
DATABASE_URL="postgresql://qrorder:CHANGE_THIS_STRONG_PASSWORD_123@db:5432/qrorder_db?schema=public"

# 2. Khóa bảo mật phiên đăng nhập (JWT & Cookie, tối thiểu 32 ký tự ngẫu nhiên)
SESSION_SECRET="CHANGE_THIS_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG"

# 3. Tên miền quán bar (Caddy sẽ tự động cấp chứng chỉ HTTPS Let's Encrypt theo tên miền này)
# Ví dụ: bar.example.com (hoặc localhost khi test dev)
DOMAIN="localhost"

# 4. Thư mục lưu trữ hình ảnh tải lên (mount với Docker volume)
UPLOAD_DIR="/app/public/uploads"

# 5. Cấu hình sao lưu dự phòng (số lượng bản sao lưu tối đa được giữ lại)
BACKUP_KEEP_COUNT=14

# 6. Cổng và môi trường
PORT=3000
NODE_ENV="production"
