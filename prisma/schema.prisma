datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo_url  String?
  theme     Json?
  plan                  String   @default("basic") // "basic" | "pro"
  image_quota_count     Int      @default(30)
  image_quota_bytes     BigInt   @default(20971520) // 20MB
  menu_display_mode     String   @default("photo") // "photo" | "minimal"
  escalation_seconds    Int      @default(60)
  offline_alert_seconds Int      @default(120)
  created_at            DateTime @default(now())

  users              User[]
  tables             Table[]
  categories         Category[]
  menu_items         MenuItem[]
  menu_images        MenuImage[]
  table_sessions     TableSession[]
  orders             Order[]
  audit_logs         AuditLog[]
  zones              Zone[]
  shifts             Shift[]
  duty_assignments   DutyAssignment[]
  service_requests   ServiceRequest[]
  request_events     RequestEvent[]
  push_subscriptions PushSubscription[]
  staff_invites      StaffInvite[]

  @@map("restaurants")
}

model User {
  id            String    @id @default(uuid())
  restaurant_id String
  email         String    @unique
  password_hash String
  name          String
  role          String    @default("staff") // "owner" | "manager" | "staff"
  is_active     Boolean   @default(true)
  last_seen_at  DateTime?
  created_at    DateTime  @default(now())

  restaurant         Restaurant         @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  audit_logs         AuditLog[]
  duty_assignments   DutyAssignment[]
  push_subscriptions PushSubscription[]
  staff_invites      StaffInvite[]
  claimed_requests   ServiceRequest[]   @relation("ClaimedRequests")
  completed_requests ServiceRequest[]   @relation("CompletedRequests")
  request_events     RequestEvent[]

  @@index([restaurant_id])
  @@map("users")
}

model Table {
  id            String   @id @default(uuid())
  restaurant_id String
  name          String
  token         String   @unique // ngau nhien >= 20 ky tu
  is_active     Boolean  @default(true)
  zone          String?  @default("outdoor") // "outdoor" (Ngoài trời), "indoor" (Trong nhà / VIP), "bar" (Quầy Bar), "dj" (Khu DJ)
  zone_id       String?
  pos_x         Float?   // Vị trí X (%) trên sơ đồ mặt bằng
  pos_y         Float?   // Vị trí Y (%) trên sơ đồ mặt bằng
  shape         String?  @default("square") // "square" | "circle" | "bar_stool"
  capacity      Int?     @default(4)

  restaurant       Restaurant       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  assigned_zone    Zone?            @relation(fields: [zone_id], references: [id], onDelete: SetNull)
  table_sessions   TableSession[]
  orders           Order[]
  service_requests ServiceRequest[]

  @@index([restaurant_id])
  @@index([token])
  @@index([zone])
  @@index([zone_id])
  @@map("tables")
}

model Category {
  id            String   @id @default(uuid())
  restaurant_id String
  name          String
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  menu_items MenuItem[]

  @@index([restaurant_id])
  @@map("categories")
}

model MenuItem {
  id            String   @id @default(uuid())
  restaurant_id String
  category_id   String
  name          String
  description   String?
  price         Int
  image_url     String?
  is_available  Boolean  @default(true)
  sort_order    Int      @default(0)

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [category_id], references: [id], onDelete: Cascade)
  image      MenuImage?
  order_items OrderItem[]

  @@index([restaurant_id])
  @@index([category_id])
  @@index([is_available])
  @@map("menu_items")
}

model MenuImage {
  id               String   @id @default(uuid())
  restaurant_id    String
  menu_item_id     String   @unique
  key_thumb        String
  key_medium       String
  key_large        String
  width            Int
  height           Int
  blur_data_url    String   @db.Text
  size_bytes_total Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  menu_item  MenuItem   @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([menu_item_id])
  @@map("menu_images")
}

model StorageCleanupQueue {
  id            String   @id @default(uuid())
  restaurant_id String
  storage_key   String
  attempts      Int      @default(0)
  last_error    String?
  created_at    DateTime @default(now())

  @@index([restaurant_id])
  @@map("storage_cleanup_queue")
}

model TableSession {
  id             String    @id @default(uuid())
  restaurant_id  String
  table_id       String
  status         String    @default("open") // "open" | "paid"
  total          Int       @default(0)
  payment_method String?   // "cash" | "transfer" | null
  opened_at      DateTime  @default(now())
  paid_at        DateTime?

  restaurant       Restaurant       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  table            Table            @relation(fields: [table_id], references: [id], onDelete: Cascade)
  orders           Order[]
  audit_logs       AuditLog[]
  service_requests ServiceRequest[]

  @@index([restaurant_id])
  @@index([table_id])
  @@index([status])
  @@index([paid_at])
  @@index([restaurant_id, status, paid_at])
  @@map("table_sessions")
}

model Order {
  id            String   @id @default(uuid())
  session_id    String
  restaurant_id String
  table_id      String
  status        String   @default("pending") // "pending" | "preparing" | "served" | "cancelled"
  note          String?
  cancel_reason String?
  created_at    DateTime @default(now())

  session          TableSession     @relation(fields: [session_id], references: [id], onDelete: Cascade)
  restaurant       Restaurant       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  table            Table            @relation(fields: [table_id], references: [id], onDelete: Cascade)
  order_items      OrderItem[]
  service_requests ServiceRequest[]

  @@index([restaurant_id])
  @@index([session_id])
  @@index([table_id])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  order_id       String
  menu_item_id   String?
  name_snapshot  String
  price_snapshot Int
  quantity       Int
  note           String?

  order     Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item MenuItem? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([menu_item_id])
  @@map("order_items")
}

model AuditLog {
  id            String   @id @default(uuid())
  restaurant_id String
  user_id       String
  action        String
  session_id    String
  reason        String
  created_at    DateTime @default(now())

  restaurant Restaurant   @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session    TableSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([session_id])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Zone {
  id            String   @id @default(uuid())
  restaurant_id String
  name          String
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())

  restaurant       Restaurant       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  tables           Table[]
  duty_assignments DutyAssignment[]

  @@index([restaurant_id])
  @@index([restaurant_id, sort_order])
  @@map("zones")
}

model Shift {
  id            String    @id @default(uuid())
  restaurant_id String
  started_by    String
  started_at    DateTime  @default(now())
  ended_at      DateTime?

  restaurant       Restaurant       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  duty_assignments DutyAssignment[]

  @@index([restaurant_id])
  @@index([restaurant_id, ended_at])
  @@map("shifts")
}

model DutyAssignment {
  id            String   @id @default(uuid())
  shift_id      String
  restaurant_id String
  user_id       String
  zone_id       String?
  on_duty       Boolean  @default(true)
  created_at    DateTime @default(now())

  shift      Shift      @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  zone       Zone?      @relation(fields: [zone_id], references: [id], onDelete: SetNull)

  @@index([restaurant_id])
  @@index([shift_id])
  @@index([user_id])
  @@index([zone_id])
  @@index([shift_id, user_id])
  @@map("duty_assignments")
}

model ServiceRequest {
  id            String    @id @default(uuid())
  restaurant_id String
  table_id      String
  session_id    String
  type          String    // "order" | "call_staff" | "request_bill"
  order_id      String?
  status        String    @default("pending") // "pending" | "claimed" | "done" | "cancelled"
  claimed_by    String?
  claimed_at    DateTime?
  completed_by  String?
  completed_at  DateTime?
  escalated_at  DateTime?
  created_at    DateTime  @default(now())

  restaurant        Restaurant     @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  table             Table          @relation(fields: [table_id], references: [id], onDelete: Cascade)
  session           TableSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  order             Order?         @relation(fields: [order_id], references: [id], onDelete: SetNull)
  claimed_by_user   User?          @relation("ClaimedRequests", fields: [claimed_by], references: [id], onDelete: SetNull)
  completed_by_user User?          @relation("CompletedRequests", fields: [completed_by], references: [id], onDelete: SetNull)
  events            RequestEvent[]

  @@index([restaurant_id])
  @@index([restaurant_id, status, created_at])
  @@index([restaurant_id, claimed_by])
  @@index([table_id])
  @@index([session_id])
  @@index([order_id])
  @@map("service_requests")
}

model RequestEvent {
  id            String   @id @default(uuid())
  request_id    String
  restaurant_id String
  actor_user_id String?
  event         String   // "created" | "notified" | "claimed" | "released" | "reassigned" | "escalated" | "done" | "cancelled"
  meta          Json?
  created_at    DateTime @default(now())

  request    ServiceRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  restaurant Restaurant     @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  actor_user User?          @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([restaurant_id])
  @@index([request_id])
  @@index([actor_user_id])
  @@index([created_at])
  @@map("request_events")
}

model PushSubscription {
  id            String    @id @default(uuid())
  user_id       String
  restaurant_id String
  endpoint      String    @unique
  p256dh        String
  auth          String
  user_agent    String?
  created_at    DateTime  @default(now())
  last_seen_at  DateTime?
  is_active     Boolean   @default(true)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([user_id])
  @@index([is_active])
  @@map("push_subscriptions")
}

model StaffInvite {
  id            String    @id @default(uuid())
  restaurant_id String
  user_id       String?
  token_hash    String    @unique
  expires_at    DateTime
  used_at       DateTime?
  created_by    String
  created_at    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([restaurant_id])
  @@index([token_hash])
  @@map("staff_invites")
}
